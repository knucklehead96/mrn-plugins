{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|Agent|Bash|Edit|Write|NotebookEdit)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-subagent-first.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/brevity.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/brevity.sh\""
          }
        ]
      }
    ]
  }
}
